{
  "applicationId": "es.canarias.invoices.app",
  "defaultMode": "window",
  "port": 0,
  "url": "/index.html",
  "enableServer": true,
  "enableNativeAPI": true,
  "documentRoot": "/dist/",
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "*"
  ],
  "nativeBlockList": [],
  "globalVariables": {
    "TEST_VAR": "Verifactu Gratuito Taratic App"
  },
  "modes": {
    "window": {
      "title": "Verifactu Gratuito Taratic",
      "icon": "/icon.png",
      "width": 1280,
      "height": 850,
      "minWidth": 1024,
      "minHeight": 700,
      "fullScreen": false,
      "alwaysOnTop": false,
      "enableInspector": true,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true
    }
  },
  "cli": {
    "binaryName": "verifactu-gratuito-taratic",
    "resourcesPath": "/dist/",
    "clientLibrary": "/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}